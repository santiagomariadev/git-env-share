{
  "name": "git-env-share",
  "version": "1.0.0",
  "description": "Node CLI tool for configuring git hooks to share env files securely",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ges": "./dist/bin/ges.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "test:ci": "GIT_ENV_SHARE_RUN_INTEGRATION=1 npm test",
    "ci": "npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santiagomariadev/git-env-share.git"
  },
  "author": "Santiago Jose Maria (santiagomariadev@gmail.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/santiagomariadev/git-env-share/issues"
  },
  "homepage": "https://github.com/santiagomariadev/git-env-share#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.0"
  }
}
