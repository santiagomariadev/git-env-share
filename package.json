{
  "name": "git-env-share",
  "version": "1.0.0",
  "description": "Node CLI tool for configuring git hooks to share env files securely",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ges": "./dist/bin/ges.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "test:ci": "GIT_ENV_SHARE_RUN_INTEGRATION=1 npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santiagomariadev/git-env-share.git"
  },
  "author": "Santiago Jose Maria (santiagomariadev@gmail.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/santiagomariadev/git-env-share/issues"
  },
  "homepage": "https://github.com/santiagomariadev/git-env-share#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3"
  }
}
